rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isAnonymousGuest() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function reservationAfter(reservationId) {
      return getAfter(/databases/$(database)/documents/reservations/$(reservationId));
    }

    function reservationBefore(reservationId) {
      return get(/databases/$(database)/documents/reservations/$(reservationId));
    }

    function isGuestSeatLock(seatId) {
      let before = resource.data;
      let after = request.resource.data;
      return isAnonymousGuest()
        && before.status == 'Available'
        && after.status == 'Pending'
        && after.held_by == request.auth.uid
        && after.reservation_id is string
        && after.diff(before).affectedKeys()
          .hasOnly(['status', 'held_by', 'reservation_id'])
        && reservationAfter(after.reservation_id).data.userId == request.auth.uid
        && reservationAfter(after.reservation_id).data.status == 'Pending'
        && seatId in reservationAfter(after.reservation_id).data.seat_ids;
    }

    // Required only for a safe owner-initiated deletion: the reservation and
    // all of its Pending seats must be released in the same transaction.
    function isGuestSeatRelease() {
      let before = resource.data;
      let after = request.resource.data;
      return isAnonymousGuest()
        && before.status == 'Pending'
        && before.held_by == request.auth.uid
        && before.reservation_id is string
        && reservationBefore(before.reservation_id).data.userId == request.auth.uid
        && after.status == 'Available'
        && after.held_by == null
        && after.reservation_id == null
        && after.diff(before).affectedKeys()
          .hasOnly(['status', 'held_by', 'reservation_id']);
    }

    match /seats/{seatId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isGuestSeatLock(seatId) || isGuestSeatRelease();
    }

    function validSeatIdAt(data, index) {
      return data.seat_ids[index] is string && data.seat_ids[index].size() > 0;
    }

    function bookedSeatMatches(data, reservationId, index) {
      let seat = getAfter(
        /databases/$(database)/documents/seats/$(data.seat_ids[index])
      );
      return seat.data.status == 'Pending'
        && seat.data.held_by == request.auth.uid
        && seat.data.reservation_id == reservationId;
    }

    function releasedSeatMatches(data, index) {
      let seat = getAfter(
        /databases/$(database)/documents/seats/$(data.seat_ids[index])
      );
      return seat.data.status == 'Available'
        && seat.data.held_by == null
        && seat.data.reservation_id == null;
    }

    function validSeatList(data) {
      return data.seat_ids is list
        && data.seat_ids.size() >= 1
        && data.seat_ids.size() <= 4
        && validSeatIdAt(data, 0)
        && (data.seat_ids.size() < 2 || validSeatIdAt(data, 1))
        && (data.seat_ids.size() < 3 || validSeatIdAt(data, 2))
        && (data.seat_ids.size() < 4 || validSeatIdAt(data, 3))
        && (data.seat_ids.size() < 2 || data.seat_ids[0] != data.seat_ids[1])
        && (data.seat_ids.size() < 3 || (
          data.seat_ids[0] != data.seat_ids[2]
          && data.seat_ids[1] != data.seat_ids[2]
        ))
        && (data.seat_ids.size() < 4 || (
          data.seat_ids[0] != data.seat_ids[3]
          && data.seat_ids[1] != data.seat_ids[3]
          && data.seat_ids[2] != data.seat_ids[3]
        ));
    }

    function validTicketNames(data) {
      return data.ticket_names is list
        && data.ticket_names.size() == data.seat_ids.size()
        && data.ticket_names[0] is string
        && data.ticket_names[0].size() >= 1 && data.ticket_names[0].size() <= 100
        && (data.ticket_names.size() < 2 || (
          data.ticket_names[1] is string
          && data.ticket_names[1].size() >= 1 && data.ticket_names[1].size() <= 100
        ))
        && (data.ticket_names.size() < 3 || (
          data.ticket_names[2] is string
          && data.ticket_names[2].size() >= 1 && data.ticket_names[2].size() <= 100
        ))
        && (data.ticket_names.size() < 4 || (
          data.ticket_names[3] is string
          && data.ticket_names[3].size() >= 1 && data.ticket_names[3].size() <= 100
        ));
    }

    function allBookedSeatsMatch(data, reservationId) {
      return bookedSeatMatches(data, reservationId, 0)
        && (data.seat_ids.size() < 2 || bookedSeatMatches(data, reservationId, 1))
        && (data.seat_ids.size() < 3 || bookedSeatMatches(data, reservationId, 2))
        && (data.seat_ids.size() < 4 || bookedSeatMatches(data, reservationId, 3));
    }

    function allReleasedSeatsMatch(data) {
      return releasedSeatMatches(data, 0)
        && (data.seat_ids.size() < 2 || releasedSeatMatches(data, 1))
        && (data.seat_ids.size() < 3 || releasedSeatMatches(data, 2))
        && (data.seat_ids.size() < 4 || releasedSeatMatches(data, 3));
    }

    function validGuestReservationCreate(reservationId) {
      let data = request.resource.data;
      return isAnonymousGuest()
        && data.keys().hasAll([
          'guest_name', 'ticket_names', 'phone_number', 'payment_method', 'servant_name',
          'seat_ids', 'userId', 'status', 'ticket_price', 'total_price', 'created_at'
        ])
        && data.keys().hasOnly([
          'guest_name', 'ticket_names', 'phone_number', 'payment_method', 'servant_name',
          'seat_ids', 'userId', 'status', 'ticket_price', 'total_price', 'created_at'
        ])
        && data.userId == request.auth.uid
        && data.guest_name is string
        && data.guest_name.size() >= 1 && data.guest_name.size() <= 100
        && data.phone_number is string
        && data.phone_number.matches('^01[0125][0-9]{8}$')
        && (data.payment_method == 'Cash' || data.payment_method == 'InstaPay')
        && data.servant_name is string
        && data.servant_name.size() >= 1 && data.servant_name.size() <= 100
        && data.status == 'Pending'
        && validSeatList(data)
        && validTicketNames(data)
        && data.ticket_price == 100
        && data.total_price == data.seat_ids.size() * 100
        && data.created_at == request.time
        && allBookedSeatsMatch(data, reservationId);
    }

    function isOwner() {
      return isAnonymousGuest() && resource.data.userId == request.auth.uid;
    }

    function validOwnerEdit() {
      let after = request.resource.data;
      return isOwner()
        && after.userId == request.auth.uid
        && after.diff(resource.data).affectedKeys().hasOnly([
          'guest_name', 'phone_number', 'payment_method', 'servant_name'
        ])
        && after.guest_name is string
        && after.guest_name.size() >= 1 && after.guest_name.size() <= 100
        && after.phone_number is string
        && after.phone_number.size() >= 7 && after.phone_number.size() <= 20
        && (after.payment_method == 'Cash' || after.payment_method == 'InstaPay')
        && after.servant_name is string
        && after.servant_name.size() >= 1 && after.servant_name.size() <= 100;
    }

    function validOwnerDelete() {
      return isOwner()
        && resource.data.status == 'Pending'
        && validSeatList(resource.data)
        && allReleasedSeatsMatch(resource.data);
    }

    match /reservations/{reservationId} {
      allow create: if isAdmin() || validGuestReservationCreate(reservationId);
      allow read: if isAdmin() || isOwner();
      allow update: if isAdmin() || validOwnerEdit();
      allow delete: if isAdmin() || validOwnerDelete();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
