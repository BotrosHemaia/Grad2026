# Copy this file to .env.local and fill in your Firebase project credentials.
# Find these values in Firebase Console > Project Settings > General > Your apps > SDK setup and configuration.
# .env.local is git-ignored and must never be committed.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Only needed to run `npm run seed:seats` — an existing admin user from
# Firebase Console > Authentication > Users (firestore.rules requires an
# authenticated admin session to create seat documents).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Add these as server-side Environment Variables in Vercel. Never prefix them
# with VITE_ and never put their real values in this file or GitHub.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
